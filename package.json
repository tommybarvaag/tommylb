{
  "name": "tommylb-web",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test:unit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "up": "pnpm dlx npm-check-updates --root --format group -i"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@next/mdx": "16.3.0-preview.5",
    "@react-pdf/renderer": "4.5.1",
    "@shikijs/transformers": "4.3.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "bowser": "^2.14.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.22.0",
    "motion": "12.42.2",
    "next": "16.3.0-preview.5",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-tweet": "3.3.1",
    "shiki": "4.3.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "0.5.20",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.1.9",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "playwright": "1.61.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.4.5",
    "vitest": "4.1.9",
    "vitest-browser-react": "2.2.0"
  }
}
