# Contact form (Resend) — https://resend.com/api-keys
RESEND_EMAIL_SENDING_API_KEY=
RESEND_EMAIL_RECIPIENT=

# Canonical base URL used by getAbsoluteUrl() (e.g. https://tommylb.com).
# Takes precedence over Vercel's host-only NEXT_PUBLIC_VERCEL_URL / VERCEL_URL;
# unset everywhere, it falls back to http://localhost:3000.
NEXT_PUBLIC_APP_URL=
